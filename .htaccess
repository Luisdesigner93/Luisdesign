# luisdesign.cl — configuración Apache (hosting cPanel)
# Requiere mod_rewrite y mod_headers (habituales en cPanel). mod_deflate y mod_expires son opcionales.

Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Una sola dirección: www redirige a luisdesign.cl. El formulario solo acepta envíos desde ese origen;
  # desde www respondía 403 y el mensaje no se guardaba
  RewriteCond %{HTTP_HOST} ^www\.luisdesign\.cl$ [NC]
  RewriteRule ^ https://luisdesign.cl%{REQUEST_URI} [L,R=301]

  # Forzar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Páginas eliminadas o movidas (no se rompen enlaces ya compartidos)
  RewriteRule ^proyectos\.html$ /proyectos/ [R=301,L]
  RewriteRule ^producto-digital(\.html)?$ / [R=301,L]
  RewriteRule ^en/digital-product(\.html)?$ / [R=301,L]

  # Archivo de verificación de Google Search Console: se sirve tal cual, sin la redirección a la URL sin .html
  RewriteRule ^google[0-9a-f]+\.html$ - [L]

  # URLs sin .html. Las direcciones antiguas se redirigen (301) a la versión limpia:
  #   /index.html y /carpeta/index.html → / y /carpeta/ ; /pagina.html → /pagina
  RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*/)?)index\.html[\s?]
  RewriteRule ^ /%1 [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?]
  RewriteRule ^ /%1 [R=301,L,NE]
  # /pagina sirve pagina.html (si existe y no es una carpeta)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # No exponer archivos ocultos, herramientas locales ni documentación del repositorio
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^(tools|_interno|\.claude)(/|$) - [F,L]
  RewriteRule ^(README\.md|\.gitignore)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  # Google Tag Manager, Analytics y Microsoft Clarity solo se cargan si la persona acepta el aviso de cookies (js/consent.js)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms; style-src 'self'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com https://www.google.com https://*.clarity.ms https://c.bing.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com https://*.clarity.ms https://c.bing.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Caché: HTML siempre revalidado; CSS/JS una semana; fuentes e imágenes un año
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(woff2|svg|png|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddDefaultCharset utf-8
  AddCharset utf-8 .html .css .js .svg .xml .txt
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml application/xml text/plain
</IfModule>
